{
 "IMG_8005": [
  {
   "start": 2.35,
   "end": 6.91,
   "text": "Первые годы жизни малыша — это особенное время."
  },
  {
   "start": 6.91,
   "end": 11.15,
   "text": "Время открытий, время улыбок,"
  },
  {
   "start": 11.15,
   "end": 15.23,
   "text": "первых шагов и, конечно же,"
  },
  {
   "start": 15.23,
   "end": 16.59,
   "text": "большой заботы."
  },
  {
   "start": 16.59,
   "end": 20.43,
   "text": "Пусть ваша работа приносит радость,"
  },
  {
   "start": 20.43,
   "end": 26.11,
   "text": "а рядом будут люди, которые искренне верят в своё дело."
  },
  {
   "start": 26.11,
   "end": 30.16,
   "text": "Спасибо вам за вашу работу, заботу."
  },
  {
   "start": 30.16,
   "end": 34.19,
   "text": "С праздником вас, команда Friso!"
  }
 ],
 "IMG_3350": [
  {
   "start": -0.05,
   "end": 2.07,
   "text": "Самое ценное в нашей работе —"
  },
  {
   "start": 2.07,
   "end": 4.55,
   "text": "это видеть, как растут и развиваются детки,"
  },
  {
   "start": 4.55,
   "end": 6.71,
   "text": "как уходит тревога с лиц родителей и"
  },
  {
   "start": 6.71,
   "end": 8.07,
   "text": "появляется улыбка."
  },
  {
   "start": 8.07,
   "end": 11.35,
   "text": "Во многом это происходит благодаря вашей компании."
  },
  {
   "start": 11.35,
   "end": 13.95,
   "text": "Хочу пожелать вашей команде вдохновения и"
  },
  {
   "start": 13.95,
   "end": 15.11,
   "text": "новых достижений."
  },
  {
   "start": 15.11,
   "end": 16.75,
   "text": "С праздником вас!"
  }
 ],
 "IMG_9695": [
  {
   "start": -0.05,
   "end": 3.59,
   "text": "От всей души поздравляю компанию и всю её"
  },
  {
   "start": 3.59,
   "end": 5.19,
   "text": "команду с юбилеем."
  },
  {
   "start": 5.19,
   "end": 8.34,
   "text": "Желаю всем здоровья, процветания,"
  },
  {
   "start": 8.34,
   "end": 12.07,
   "text": "успеха в работе, мирного неба над нашими головами."
  },
  {
   "start": 12.07,
   "end": 14.67,
   "text": "И надеюсь, мы будем ещё долго сотрудничать"
  },
  {
   "start": 14.67,
   "end": 15.99,
   "text": "вместе с вами."
  }
 ],
 "IMG_7046": [
  {
   "start": -0.05,
   "end": 4.47,
   "text": "Знаете, мне кажется, самое прекрасное в нашей"
  },
  {
   "start": 4.47,
   "end": 7.41,
   "text": "работе — это люди, которые со временем"
  },
  {
   "start": 7.41,
   "end": 9.27,
   "text": "становятся нам не просто коллегами,"
  },
  {
   "start": 9.27,
   "end": 10.95,
   "text": "а настоящей семьей."
  },
  {
   "start": 10.95,
   "end": 14.79,
   "text": "Мы все одна оила, одна большая семья,"
  },
  {
   "start": 14.79,
   "end": 18.34,
   "text": "которую объединяет любовь к детям,"
  },
  {
   "start": 18.34,
   "end": 20.44,
   "text": "забота и общие ценности."
  },
  {
   "start": 20.44,
   "end": 24.16,
   "text": "И сегодня хочется сказать спасибо за то, что мы..."
  },
  {
   "start": 24.16,
   "end": 28.57,
   "text": "можем быть частью чего-то доброго и важного."
  },
  {
   "start": 28.57,
   "end": 32.97,
   "text": "Желаю команде Фриса и отдельно Сартикджану"
  },
  {
   "start": 32.97,
   "end": 36.68,
   "text": "процветания, развития и еще больше счастливых"
  },
  {
   "start": 36.68,
   "end": 39.51,
   "text": "детских историй с теплом и благодарностью."
  }
 ],
 "IMG_8304": [
  {
   "start": -0.05,
   "end": 4.67,
   "text": "Ваша компания — это важная миссия."
  },
  {
   "start": 4.67,
   "end": 7.35,
   "text": "Забота о самом дорогом, о детях,"
  },
  {
   "start": 7.35,
   "end": 11.59,
   "text": "их здоровье, росте и счастливом будущем."
  },
  {
   "start": 11.59,
   "end": 13.83,
   "text": "Желаю вам неиссякаемой энергии,"
  },
  {
   "start": 13.83,
   "end": 18.37,
   "text": "вдохновения, процветания и уверенного движения вперед."
  },
  {
   "start": 18.37,
   "end": 21.69,
   "text": "Пусть каждый ваш день будет наполнен добрыми"
  },
  {
   "start": 21.69,
   "end": 24.25,
   "text": "событиями, искренними улыбками."
  },
  {
   "start": 24.25,
   "end": 26.53,
   "text": "радостью от проделанной работы."
  },
  {
   "start": 26.53,
   "end": 29.37,
   "text": "Пусть в коллективе заряд тепло,"
  },
  {
   "start": 30.03,
   "end": 33.61,
   "text": "взаимопонимание, уважение, а все задуманные"
  },
  {
   "start": 33.61,
   "end": 35.69,
   "text": "планы воплощаются в жизнь."
  },
  {
   "start": 35.69,
   "end": 39.65,
   "text": "Пусть доверие людей, профессионализм команды и"
  },
  {
   "start": 39.65,
   "end": 42.77,
   "text": "высокое качество продукции остаются основой"
  },
  {
   "start": 42.77,
   "end": 44.37,
   "text": "вашего успеха."
  },
  {
   "start": 44.37,
   "end": 46.17,
   "text": "Вы дарите здоровье."
  },
  {
   "start": 46.17,
   "end": 49.71,
   "text": "пользу и радость самым маленьким потребителям,"
  },
  {
   "start": 49.71,
   "end": 52.96,
   "text": "а родителям спокойствие и уверенность."
  },
  {
   "start": 52.96,
   "end": 56.76,
   "text": "Пусть добро возвращается к вам многократно."
  },
  {
   "start": 56.76,
   "end": 59.8,
   "text": "С Днем рождения, с теплом и наилучшими"
  },
  {
   "start": 59.8,
   "end": 60.6,
   "text": "пожеланиями!"
  }
 ],
 "IMG_7246": [
  {
   "start": -0.05,
   "end": 4.67,
   "text": "Миллионы людей приходят и уходят."
  },
  {
   "start": 4.67,
   "end": 6.75,
   "text": "Меняются компании, меняются люди."
  },
  {
   "start": 6.75,
   "end": 10.75,
   "text": "Но настоящие ценности остаются неизменными."
  },
  {
   "start": 10.75,
   "end": 13.01,
   "text": "Для нас врачи — это здоровье детей,"
  },
  {
   "start": 13.01,
   "end": 16.03,
   "text": "доверие родителей, и сплочённость людей,"
  },
  {
   "start": 16.03,
   "end": 18.04,
   "text": "которые идут к одной цели."
  },
  {
   "start": 18.04,
   "end": 20.68,
   "text": "И здорово, когда рядом есть партнеры,"
  },
  {
   "start": 20.68,
   "end": 23.64,
   "text": "которые разделяют эти ценности и заботу о"
  },
  {
   "start": 23.64,
   "end": 25.0,
   "text": "будущем поколении."
  },
  {
   "start": 25.0,
   "end": 27.44,
   "text": "С днем рождения Фриса, за детей,"
  },
  {
   "start": 27.44,
   "end": 31.6,
   "text": "за наше дело и за людей, которые идут к одной цели."
  }
 ]
}