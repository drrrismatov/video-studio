{
 "IMG_8005": [
  {
   "start": 2.35,
   "end": 5.03,
   "text": "Первые годы жизни малыша — это"
  },
  {
   "start": 5.03,
   "end": 6.91,
   "text": "особенное время."
  },
  {
   "start": 6.91,
   "end": 11.15,
   "text": "Время открытий, время улыбок,"
  },
  {
   "start": 11.15,
   "end": 15.23,
   "text": "первых шагов и, конечно же,"
  },
  {
   "start": 15.23,
   "end": 16.59,
   "text": "большой заботы."
  },
  {
   "start": 16.59,
   "end": 19.43,
   "text": "Пусть ваша работа приносит"
  },
  {
   "start": 19.43,
   "end": 22.39,
   "text": "радость, а рядом будут люди,"
  },
  {
   "start": 22.39,
   "end": 26.11,
   "text": "которые искренне верят в своё дело."
  },
  {
   "start": 26.11,
   "end": 30.16,
   "text": "Спасибо вам за вашу работу, заботу."
  },
  {
   "start": 30.16,
   "end": 34.19,
   "text": "С праздником вас, команда Friso!"
  }
 ],
 "IMG_3350": [
  {
   "start": -0.05,
   "end": 2.07,
   "text": "Самое ценное в нашей работе —"
  },
  {
   "start": 2.07,
   "end": 3.23,
   "text": "это видеть, как растут и"
  },
  {
   "start": 3.23,
   "end": 5.31,
   "text": "развиваются детки, как уходит"
  },
  {
   "start": 5.31,
   "end": 6.71,
   "text": "тревога с лиц родителей и"
  },
  {
   "start": 6.71,
   "end": 8.07,
   "text": "появляется улыбка."
  },
  {
   "start": 8.07,
   "end": 9.83,
   "text": "Во многом это происходит"
  },
  {
   "start": 9.83,
   "end": 11.35,
   "text": "благодаря вашей компании."
  },
  {
   "start": 11.35,
   "end": 13.35,
   "text": "Хочу пожелать вашей команде"
  },
  {
   "start": 13.35,
   "end": 15.11,
   "text": "вдохновения и новых достижений."
  },
  {
   "start": 15.11,
   "end": 16.75,
   "text": "С праздником вас!"
  }
 ],
 "IMG_9695": [
  {
   "start": -0.05,
   "end": 2.39,
   "text": "От всей души поздравляю"
  },
  {
   "start": 2.39,
   "end": 5.19,
   "text": "компанию и всю её команду с юбилеем."
  },
  {
   "start": 5.19,
   "end": 7.07,
   "text": "Желаю всем здоровья,"
  },
  {
   "start": 7.07,
   "end": 9.87,
   "text": "процветания, успеха в работе,"
  },
  {
   "start": 9.87,
   "end": 12.07,
   "text": "мирного неба над нашими головами."
  },
  {
   "start": 12.07,
   "end": 13.99,
   "text": "И надеюсь, мы будем ещё долго"
  },
  {
   "start": 13.99,
   "end": 15.99,
   "text": "сотрудничать вместе с вами."
  }
 ],
 "IMG_7046": [
  {
   "start": -0.05,
   "end": 3.55,
   "text": "Знаете, мне кажется, самое"
  },
  {
   "start": 3.55,
   "end": 5.11,
   "text": "прекрасное в нашей работе —"
  },
  {
   "start": 5.11,
   "end": 7.41,
   "text": "это люди, которые со временем"
  },
  {
   "start": 7.41,
   "end": 8.43,
   "text": "становятся нам не просто"
  },
  {
   "start": 8.43,
   "end": 10.95,
   "text": "коллегами, а настоящей семьей."
  },
  {
   "start": 10.95,
   "end": 14.15,
   "text": "Мы все одна оила, одна большая"
  },
  {
   "start": 14.15,
   "end": 15.79,
   "text": "семья, которую объединяет"
  },
  {
   "start": 15.79,
   "end": 20.44,
   "text": "любовь к детям, забота и общие ценности."
  },
  {
   "start": 20.44,
   "end": 22.0,
   "text": "И сегодня хочется сказать"
  },
  {
   "start": 22.0,
   "end": 24.16,
   "text": "спасибо за то, что мы..."
  },
  {
   "start": 24.16,
   "end": 25.92,
   "text": "можем быть частью чего-то"
  },
  {
   "start": 25.92,
   "end": 28.57,
   "text": "доброго и важного."
  },
  {
   "start": 28.57,
   "end": 31.68,
   "text": "Желаю команде Фриса и отдельно"
  },
  {
   "start": 32.22,
   "end": 33.71,
   "text": "Сартикджану процветания,"
  },
  {
   "start": 33.71,
   "end": 35.92,
   "text": "развития и еще больше"
  },
  {
   "start": 35.92,
   "end": 37.99,
   "text": "счастливых детских историй с"
  },
  {
   "start": 37.99,
   "end": 39.51,
   "text": "теплом и благодарностью."
  }
 ],
 "IMG_8304": [
  {
   "start": -0.05,
   "end": 4.67,
   "text": "Ваша компания — это важная миссия."
  },
  {
   "start": 4.67,
   "end": 6.63,
   "text": "Забота о самом дорогом, о"
  },
  {
   "start": 6.63,
   "end": 9.51,
   "text": "детях, их здоровье, росте и"
  },
  {
   "start": 9.51,
   "end": 11.59,
   "text": "счастливом будущем."
  },
  {
   "start": 11.59,
   "end": 13.19,
   "text": "Желаю вам неиссякаемой"
  },
  {
   "start": 13.19,
   "end": 14.79,
   "text": "энергии, вдохновения,"
  },
  {
   "start": 14.79,
   "end": 16.99,
   "text": "процветания и уверенного"
  },
  {
   "start": 16.99,
   "end": 18.37,
   "text": "движения вперед."
  },
  {
   "start": 18.37,
   "end": 20.57,
   "text": "Пусть каждый ваш день будет"
  },
  {
   "start": 20.57,
   "end": 22.45,
   "text": "наполнен добрыми событиями,"
  },
  {
   "start": 22.45,
   "end": 24.25,
   "text": "искренними улыбками."
  },
  {
   "start": 24.25,
   "end": 26.53,
   "text": "радостью от проделанной работы."
  },
  {
   "start": 26.53,
   "end": 28.57,
   "text": "Пусть в коллективе заряд"
  },
  {
   "start": 28.57,
   "end": 30.53,
   "text": "тепло, взаимопонимание,"
  },
  {
   "start": 30.89,
   "end": 33.61,
   "text": "уважение, а все задуманные"
  },
  {
   "start": 33.61,
   "end": 35.69,
   "text": "планы воплощаются в жизнь."
  },
  {
   "start": 35.69,
   "end": 37.29,
   "text": "Пусть доверие людей,"
  },
  {
   "start": 37.29,
   "end": 39.65,
   "text": "профессионализм команды и"
  },
  {
   "start": 39.65,
   "end": 41.57,
   "text": "высокое качество продукции"
  },
  {
   "start": 41.57,
   "end": 44.37,
   "text": "остаются основой вашего успеха."
  },
  {
   "start": 44.37,
   "end": 46.17,
   "text": "Вы дарите здоровье."
  },
  {
   "start": 46.17,
   "end": 48.05,
   "text": "пользу и радость самым"
  },
  {
   "start": 48.05,
   "end": 50.25,
   "text": "маленьким потребителям, а"
  },
  {
   "start": 50.25,
   "end": 52.01,
   "text": "родителям спокойствие и"
  },
  {
   "start": 52.01,
   "end": 52.96,
   "text": "уверенность."
  },
  {
   "start": 52.96,
   "end": 55.4,
   "text": "Пусть добро возвращается к вам"
  },
  {
   "start": 55.4,
   "end": 56.76,
   "text": "многократно."
  },
  {
   "start": 56.76,
   "end": 59.04,
   "text": "С Днем рождения, с теплом и"
  },
  {
   "start": 59.04,
   "end": 60.6,
   "text": "наилучшими пожеланиями!"
  }
 ],
 "IMG_7246": [
  {
   "start": -0.05,
   "end": 4.67,
   "text": "Миллионы людей приходят и уходят."
  },
  {
   "start": 4.67,
   "end": 6.75,
   "text": "Меняются компании, меняются люди."
  },
  {
   "start": 6.75,
   "end": 9.55,
   "text": "Но настоящие ценности остаются"
  },
  {
   "start": 9.55,
   "end": 10.75,
   "text": "неизменными."
  },
  {
   "start": 10.75,
   "end": 12.31,
   "text": "Для нас врачи — это здоровье"
  },
  {
   "start": 12.31,
   "end": 14.99,
   "text": "детей, доверие родителей, и"
  },
  {
   "start": 14.99,
   "end": 16.39,
   "text": "сплочённость людей, которые"
  },
  {
   "start": 16.39,
   "end": 18.04,
   "text": "идут к одной цели."
  },
  {
   "start": 18.04,
   "end": 20.04,
   "text": "И здорово, когда рядом есть"
  },
  {
   "start": 20.04,
   "end": 21.72,
   "text": "партнеры, которые разделяют"
  },
  {
   "start": 21.72,
   "end": 23.64,
   "text": "эти ценности и заботу о"
  },
  {
   "start": 23.64,
   "end": 25.0,
   "text": "будущем поколении."
  },
  {
   "start": 25.0,
   "end": 26.8,
   "text": "С днем рождения Фриса, за"
  },
  {
   "start": 26.8,
   "end": 28.88,
   "text": "детей, за наше дело и за"
  },
  {
   "start": 28.88,
   "end": 31.6,
   "text": "людей, которые идут к одной цели."
  }
 ]
}